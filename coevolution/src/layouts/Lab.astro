---
// Каркас поддомена coevolution.parmenides.academy: «лабораторный» стиль по мотивам Santal (Awwwards SOTD 15.11.2026) —
// светло-серая бумага, почти чёрные чернила, волосяная сетка колонок, огромный словесный знак; плюс два цвета: бирюза и коралл.
// Меню своё; основной сайт Parmenides Academy — отдельным окошком.
interface Props {
  title: string;
  description: string;
  path?: string;
  jsonld?: object | object[];
  /** показывать огромный словесный знак наверху (только на главной) */
  hero?: boolean;
}
const { title, description, path = '/', jsonld, hero = false } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const MAIN = 'https://parmenides.academy';
const YT = 'https://www.youtube.com/@weformeachother_aihumans';
const TG = 'https://t.me/timuratnashev';
const NAV: [string, string, boolean?][] = [
  ['/', 'Выпуски'],
  ['/#o-podkaste', 'О подкасте'],
  [YT, 'YouTube ↗', true],
];
const isActive = (href: string) => (href === '/' ? path === '/' : !href.startsWith('http') && !href.includes('#') && path.startsWith(href));
const ld = Array.isArray(jsonld) ? jsonld : jsonld ? [jsonld] : [];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#F3F7F5" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&family=Unbounded:wght@500;700;800&display=swap" rel="stylesheet" />
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body>
    {hero && (
      <a class="mark" href="/" aria-label="Коэволюция — на главную">
        <svg viewBox="0 0 1000 150" role="img" aria-hidden="true"><text x="0" y="118" font-size="140" textLength="1000" lengthAdjust="spacingAndGlyphs">КОЭВОЛЮЦИЯ</text></svg>
      </a>
    )}
    <header class="top">
      <nav class="grid nav" aria-label="Разделы">
        <a class="plus" href="/" aria-label="На главную"><span class="logo"><i></i><i></i></span><span class="nm">Коэволюция</span></a>
        {NAV.map(([href, label, ext]) => (
          <a class:list={['ni', { on: isActive(href) }]} href={href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
        ))}
        <a class="window" href={MAIN} title="Основной сайт: семинар медленного чтения «Парменида»">
          <span class="wk">Основной сайт</span>
          <span class="wt">Parmenides Academy ↗</span>
        </a>
      </nav>
    </header>

    <main><slot /></main>

    <footer class="foot">
      <div class="grid fg">
        <div class="fcol">
          <span class="lab">Кто кого образует · We Form Each Other</span>
          <span>Подкаст Тимура Атнашева и Кирилла Кринкина о ко-эволюции людей и ИИ.</span>
        </div>
        <div class="fcol">
          <span class="lab">Разделы</span>
          <a href="/">Выпуски</a><a href="/#o-podkaste">О подкасте</a>
        </div>
        <div class="fcol">
          <span class="lab">Связь</span>
          <a href={YT} target="_blank" rel="noopener">YouTube ↗</a><a href={TG} target="_blank" rel="noopener">Telegram Тимура ↗</a>
        </div>
        <a class="window big" href={MAIN}>
          <span class="wk">Основной сайт</span>
          <span class="wt">Parmenides Academy ↗</span>
          <span class="wd">Семинар медленного чтения «Парменида» Платона</span>
        </a>
      </div>
      <p class="grid copy"><span>© Тимур Атнашев, Кирилл Кринкин · {new Date().getFullYear()}</span><span>Материалы открыты для чтения и цитирования со ссылкой на источник.</span></p>
    </footer>
  </body>
</html>

<style is:global>
  /* Палитра и шрифты — из исходного артефакта «Дерево гипотез» (claude/site/coevolution/gipotezy.astro), решение Тимура 19.11.2026 */
  :root {
    --bg: #F3F7F5; --paper-2: #FFFFFF; --ink: #0A1F1A; --soft: #51635C; --line: #CFDBD6; --grid: rgba(10,31,26,.055);
    --green: #00A562; --blue: #1450F0; --green-soft: #D9F3E6; --blue-soft: #DFE8FE; --on-band: #FFFFFF; --field: #A35E00;
    /* старые имена в разметке → цвета артефакта */
    --teal: var(--green); --teal-l: var(--green); --teal-t: var(--green-soft); --coral: var(--blue); --coral-t: var(--blue-soft); --blue-t: var(--blue-soft);
    --display: 'Unbounded', 'Golos Text', system-ui, sans-serif;
    --sans: 'Golos Text', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, Consolas, monospace;
    --cols: repeat(6, minmax(0, 1fr));
    --paper: var(--bg); --gold: var(--blue); --gold-2: var(--line); --amber: var(--field); --serif: var(--sans);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0B1512; --paper-2: #111E1A; --ink: #E8F1ED; --soft: #93A7A0; --line: #263832; --grid: rgba(232,241,237,.05);
      --green: #1FD08A; --blue: #6F97FF; --green-soft: #12362A; --blue-soft: #1A2850; --on-band: #04130E; --field: #E7AB55;
      color-scheme: dark;
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background-color: var(--bg); color: var(--ink); font: 400 16px/1.5 var(--sans);
    background-image: repeating-linear-gradient(90deg, var(--grid) 0 1px, transparent 1px calc(100% / 12)); background-size: calc(100% - 40px) 100%; background-position: 20px 0; background-repeat: no-repeat; }
  a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  a:hover { color: var(--blue); }
  :focus-visible { outline: 2px solid var(--coral); outline-offset: 2px; }
  h1, h2, h3 { font-weight: 500; letter-spacing: -.01em; margin: 0; text-wrap: balance; }
  p { margin: 0; }
  .grid { display: grid; grid-template-columns: var(--cols); column-gap: 0; padding: 0 20px; }
  .lab { display: block; font-family: var(--mono); font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; color: var(--soft); }

  /* словесный знак во всю ширину */
  .mark { display: block; padding: 6px 20px 0; color: var(--ink); text-decoration: none; }
  .mark svg { display: block; width: 100%; height: auto; overflow: visible; }
  .mark text { font-family: var(--display); font-weight: 800; fill: currentColor; }
  .mark:hover { color: var(--ink); }

  /* меню по колонкам, с засечками сетки */
  .top { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(6px); }
  .nav { border-bottom: 1px solid var(--line); align-items: stretch; font-size: .9rem; }
  .nav > a { position: relative; padding: 12px 10px 12px 0; text-decoration: none; }
  .nav > a.ni::before { content: ''; position: absolute; left: 0; bottom: -1px; width: 1px; height: 7px; background: var(--ink); }
  .nav > a.ni { padding-left: 8px; }
  .nav > a.on { color: var(--teal); font-weight: 600; }
  .nav > a.on::after { content: ''; position: absolute; left: 0; right: 10px; bottom: -1px; height: 2px; background: var(--teal); }
  .plus { display: flex; align-items: center; gap: 10px; font-weight: 600; }
  .logo { position: relative; width: 26px; height: 16px; flex: none; }
  .logo i { position: absolute; top: 0; width: 16px; height: 16px; border-radius: 50%; border: 2px solid var(--blue); }
  .logo i + i { left: 10px; border-color: var(--coral); mix-blend-mode: multiply; }
  /* окошко основного сайта: тон Parmenides Academy (бумага, золото, вино) */
  .nav > a.window, .window { justify-self: end; align-self: center; display: flex; flex-direction: column; gap: 1px; text-decoration: none; border: 1px solid #A9782B; border-radius: 3px; padding: 7px 16px 8px; margin: 8px 0; background: #F3E9D2; color: #3B2410; line-height: 1.2; box-shadow: inset 0 0 0 3px #FBF6EA; transition: background .2s, color .2s, border-color .2s; }
  .window .wk { font-size: .64rem; letter-spacing: .1em; text-transform: uppercase; color: #8A6326; }
  .window .wt { font-weight: 600; font-size: .9rem; color: #7A2230; }
  .nav > a.window:hover, .window:hover { background: #EBDCBC; border-color: #8A6326; color: #3B2410; }

  main { min-height: 50vh; }
  /* внутренние страницы (дерево гипотез) */
  .gtwrap { padding-top: 26px; }
  .gtwrap .kick { display: block; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; color: var(--coral); margin: 8px 0 10px; }
  .gtwrap h1 { font-size: clamp(2.4rem, 6vw, 5.2rem); font-weight: 500; line-height: .95; letter-spacing: -.035em; margin: 0 0 14px; }
  .gtwrap .sub { font-size: clamp(1.05rem, 1.6vw, 1.35rem); color: var(--soft); max-width: 60ch; margin: 0 0 10px; }
  .gtwrap h2 { font-size: clamp(1.4rem, 2.4vw, 2rem); font-weight: 500; border-top: 1px solid var(--ink); padding-top: 10px; }
  .gtwrap h3 { font-weight: 600; }
  .wrap { padding: 0 20px; }

  .foot { margin-top: 90px; border-top: 3px solid var(--blue); border-image: linear-gradient(100deg, var(--green), var(--blue)) 1; background: var(--bg); }
  .fg { padding-top: 22px; padding-bottom: 26px; row-gap: 22px; }
  .fcol { display: flex; flex-direction: column; gap: 4px; padding-right: 16px; font-size: .92rem; }
  .fcol:first-child { grid-column: span 2; }
  .fcol a { text-decoration: none; }
  .window.big { grid-column: span 2; justify-self: stretch; align-self: start; padding: 16px 20px 18px; margin: 0; }
  .window.big .wt { font-size: 1.3rem; font-weight: 600; margin: 3px 0 4px; }
  .window.big .wd { font-size: .86rem; color: #5A4126; }
  .copy { border-top: 1px solid var(--line); padding-top: 12px; padding-bottom: 20px; font-size: .78rem; color: var(--soft); }
  .copy span:first-child { grid-column: span 3; }
  .copy span:last-child { grid-column: span 3; }

  @media (max-width: 860px) {
    :root { --cols: repeat(2, minmax(0, 1fr)); }
    .nav { display: flex; align-items: center; gap: 0; padding-right: 12px; font-size: .86rem; }
    .nav .plus { padding-right: 10px; }
    .nav .plus .nm { display: none; }
    .nav > a.ni { padding: 12px 9px; white-space: nowrap; }
    .nav > a.ni[target] { display: none; }
    .nav > a.window { margin-left: auto; padding: 6px 10px; white-space: nowrap; flex: none; }
    .nav .window .wk { display: none; }
    .nav .window .wt { font-size: .76rem; }
    .fcol:first-child, .window.big { grid-column: span 2; }
    .copy span:first-child, .copy span:last-child { grid-column: span 2; }
  }
  @media (max-width: 520px) {
    body { font-size: 16px; }
    .nav > a.ni { padding: 12px 7px; font-size: .82rem; }
    .nav .window .wt { font-size: 0; }
    .nav .window .wt::after { content: 'Parmenides ↗'; font-size: .74rem; }
  }
</style>
