const el=(t,cls,txt)=>{const e=document.createElement(t);if(cls)e.className=cls;if(txt!=null)e.textContent=txt;return e;};
function plural(n){const a=n%10,b=n%100;return a===1&&b!==11?"карточка":(a>=2&&a<=4&&(b<10||b>=20)?"карточки":"карточек");}
function cap(s){return s.charAt(0).toUpperCase()+s.slice(1);}

const prem=document.getElementById("prem");
PREM.forEach(([k,t])=>{const d=el("div");d.append(el("b",null,k),el("span",null,t));prem.append(d);});

const moves=document.getElementById("moves");
MOVES.forEach(([d,t,why,to])=>{const li=el("li");const mid=el("div");mid.append(el("b",null,t+". "),document.createTextNode(why));
  li.append(el("time",null,d),mid,el("span","to",to));moves.append(li);});

const tree=document.getElementById("tree"); const links={}; let attach=0;
H.forEach(h=>{
  const fresh=(h.k||[]).filter(x=>NEW.has(x[0])).length+(h.m||[]).filter(x=>NEW.has(x[0])).length;
  const row=el("section","h"+(h.node?" node":"")+(h.cand?" cand":"")); row.dataset.node=h.node?"1":"0"; row.dataset.fresh=fresh?"1":"0";
  row.append(el("div","code",h.c));
  const b=el("div","hb"), t=el("div","title");
  t.append(el("strong",null,h.n));
  t.append(el("span","chip"+(h.sc?" s-"+h.sc:""),h.s));
  if(h.node) t.append(el("span","chip nodechip","узел · "+((h.k||[]).length)+" "+plural((h.k||[]).length)));
  if(fresh) t.append(el("span","chip newchip","новое: "+fresh));
  b.append(t, el("p","say",h.say));
  if(h.now){const p=el("p","now");p.append(el("b",null,"Сейчас: "),document.createTextNode(h.now+" "),el("b",null,"Дальше: "),document.createTextNode(h.next));b.append(p);}
  if(h.k||h.m){
    const ul=el("ul","cards");
    (h.k||[]).forEach(([id,tag,txt])=>{attach++;(links[id]=links[id]||[]).push(h.c);
      const li=el("li",NEW.has(id)?"new":""); li.append(el("time",null,C[id][0]));
      const d=el("div"); const i=txt.indexOf(":");
      d.append(el("span","nm",C[id][1]+". "),el("b","tag t-"+tag,cap(i<0?txt:txt.slice(0,i))),document.createTextNode(i<0?"":txt.slice(i)));
      li.append(d); ul.append(li);});
    (h.m||[]).forEach(([id,txt])=>{const li=el("li",NEW.has(id)?"new":""); li.append(el("time",null,M[id][0]));
      const d=el("div"); d.append(el("span","nm",M[id][1]+". "),el("b","tag t-mat","Материал"),document.createTextNode(": "+txt)); li.append(d); ul.append(li);});
    b.append(ul);
  }
  row.append(b); tree.append(row);
});

const idx=document.getElementById("idx");
const key=d=>{const [dd,mm]=d.split(".").map(Number);return mm*100+dd;};
Object.keys(C).sort((a,b)=>key(C[b][0])-key(C[a][0])).forEach(id=>{const d=el("div");
  d.append(el("time",null,C[id][0]),el("span","n",C[id][1]),el("span","to",(links[id]||["—"]).join(" · ")));idx.append(d);});

const nc=Object.keys(C).length;
const counts=document.getElementById("counts");
[[H.filter(h=>/^H/.test(h.c)).length,"гипотез и кандидатов"],[H.filter(h=>h.node).length,"узлов"],[nc,plural(nc)],[attach,"привязок карточек к гипотезам"]]
 .forEach(([n,t])=>{const d=el("div","count");d.append(el("b",null,String(n)),el("span",null,t));counts.append(d);});

const btn={all:document.getElementById("f-all"),nodes:document.getElementById("f-nodes"),fresh:document.getElementById("f-new")};
function setF(mode){Object.entries(btn).forEach(([k,b])=>b.setAttribute("aria-pressed",String(k===mode)));
  tree.querySelectorAll(".h").forEach(r=>{r.hidden=(mode==="nodes"&&r.dataset.node!=="1")||(mode==="fresh"&&r.dataset.fresh!=="1");});}
btn.all.addEventListener("click",()=>setF("all"));btn.nodes.addEventListener("click",()=>setF("nodes"));btn.fresh.addEventListener("click",()=>setF("fresh"));
</script>
</body>
</html>
