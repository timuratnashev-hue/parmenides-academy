<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Дерево гипотез — Коэволюция</title>
<meta name="description" content="Ядро, гипотезы, узлы и карточки проекта о коэволюции людей и ИИ-агентов: 21 гипотеза, 10 узлов, 41 карточка. Состояние на 18 ноября 2026.">
<meta name="robots" content="noindex, nofollow">
<link rel="canonical" href="https://coevolution.parmenides.academy/gipotezy">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&family=Unbounded:wght@500;700;800&display=swap">
<style is:global>
html,body{margin:0}
[hidden]{display:none!important}
img{max-width:100%}

/* Раскладка: лабораторный лист на сетке из 12 колонок. Сверху знак во всю ширину, под ним зелёно-синяя полоса с названием страницы и счётчиками; дальше ствол (коды гипотез) слева и ветви-карточки справа. */
:root{
  --paper:#F3F7F5; --sheet:#FFFFFF; --ink:#0A1F1A; --muted:#51635C; --line:#CFDBD6; --grid:rgba(10,31,26,.055);
  --green:#00A562; --blue:#1450F0; --green-soft:#D9F3E6; --blue-soft:#DFE8FE; --on-band:#FFFFFF;
  --plus:#008A50; --shift:#1450F0; --minus:#C2362B; --form:#00766F; --field:#A35E00; --mat:#51635C; --new:#1450F0;
  --display:"Unbounded","Golos Text",system-ui,sans-serif;
  --body:"Golos Text",system-ui,-apple-system,"Segoe UI",sans-serif;
  --mono:"JetBrains Mono",ui-monospace,Consolas,monospace;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --paper:#0B1512; --sheet:#111E1A; --ink:#E8F1ED; --muted:#93A7A0; --line:#263832; --grid:rgba(232,241,237,.05);
    --green:#1FD08A; --blue:#6F97FF; --green-soft:#12362A; --blue-soft:#1A2850; --on-band:#04130E;
    --plus:#3FD795; --shift:#86A8FF; --minus:#F08A80; --form:#4FD3C8; --field:#E7AB55; --mat:#93A7A0; --new:#86A8FF;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --paper:#0B1512; --sheet:#111E1A; --ink:#E8F1ED; --muted:#93A7A0; --line:#263832; --grid:rgba(232,241,237,.05);
  --green:#1FD08A; --blue:#6F97FF; --green-soft:#12362A; --blue-soft:#1A2850; --on-band:#04130E;
  --plus:#3FD795; --shift:#86A8FF; --minus:#F08A80; --form:#4FD3C8; --field:#E7AB55; --mat:#93A7A0; --new:#86A8FF;
  color-scheme:dark;
}
*{box-sizing:border-box}
body{background:var(--paper);color:var(--ink);font-family:var(--body);font-size:15px;line-height:1.5}
.page{max-width:1280px;margin:0 auto;padding-block:0 64px;
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));
  background-image:repeating-linear-gradient(90deg,var(--grid) 0 1px,transparent 1px calc(100%/12));background-size:calc(100% - 32px) 100%;background-position:16px 0;background-repeat:no-repeat}
a{color:inherit}
a:focus-visible,button:focus-visible{outline:2px solid var(--blue);outline-offset:2px}

/* шапка */
.top{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px 20px;padding:14px 0;border-bottom:1px solid var(--line);font-size:13.5px}
.top nav{display:flex;flex-wrap:wrap;gap:4px 18px}
.top nav a{text-decoration:none;font-weight:500;color:var(--muted)}
.top nav a:hover{color:var(--ink)}
.top .here{font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
/* кнопка основного сайта — в тоне Parmenides Academy (бумага, золото, вино), как на остальных страницах поддомена */
.win{display:inline-flex;align-items:center;gap:6px;border:1px solid #A9782B;border-radius:3px;padding:6px 14px;text-decoration:none;font-weight:600;background:#F3E9D2;color:#7A2230;box-shadow:inset 0 0 0 3px #FBF6EA}
.win:hover{background:#EBDCBC;border-color:#8A6326}
.mark{display:block;width:100%;height:auto;margin:10px 0 6px}
.mark text{font-family:var(--display);font-weight:800;fill:var(--ink)}

/* полоса */
.band{background:linear-gradient(100deg,var(--green) 0%,var(--blue) 100%);color:var(--on-band);border-radius:6px;padding:22px 24px;display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:18px 32px;align-items:end}
.band h1{font-family:var(--display);font-weight:700;font-size:clamp(24px,3.6vw,40px);line-height:1.08;margin:0;text-wrap:balance}
.band p{margin:8px 0 0;max-width:52ch;font-size:15px}
.counts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;border-top:1px solid color-mix(in srgb,var(--on-band) 55%,transparent)}
.count{padding:10px 12px 0 0;display:flex;flex-direction:column;gap:2px;min-width:0}
.count b{font-family:var(--mono);font-weight:700;font-size:clamp(22px,3vw,34px);line-height:1;font-variant-numeric:tabular-nums}
.count span{font-size:12.5px;line-height:1.3}

h2{font-family:var(--display);font-weight:500;font-size:14px;letter-spacing:.06em;text-transform:uppercase;margin:44px 0 14px;display:flex;align-items:center;gap:12px}
h2::after{content:"";flex:1;height:1px;background:var(--line)}
.lead{color:var(--muted);max-width:68ch;margin:-6px 0 14px}

/* ядро */
.core{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border:1px solid var(--line);background:var(--sheet);border-radius:6px}
.core>div{padding:16px 18px;border-left:1px solid var(--line);min-width:0}
.core>div:first-child{border-left:0}
.core h3{margin:0 0 6px;font-family:var(--mono);font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--plus)}
.core p{margin:0}
.src{display:block;color:var(--muted);font-size:12.5px;margin-top:8px}
.prem{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:0 24px;margin-top:14px}
.prem div{border-bottom:1px solid var(--line);padding:7px 0;font-size:14px;display:grid;grid-template-columns:34px 1fr;gap:6px}
.prem b{font-family:var(--mono);color:var(--shift)}

/* новые ходы */
.moves{list-style:none;margin:0;padding:0;border:1px solid var(--line);border-radius:6px;background:var(--sheet)}
.moves li{display:grid;grid-template-columns:64px minmax(0,1fr) auto;gap:6px 16px;padding:10px 16px;border-top:1px solid var(--line);align-items:baseline}
.moves li:first-child{border-top:0}
.moves time,.cards time,.idx time{font-family:var(--mono);font-size:12px;color:var(--muted);font-variant-numeric:tabular-nums}
.moves .to{font-family:var(--mono);font-size:11.5px;color:var(--shift);white-space:nowrap}
.moves b{font-weight:600}
.wait{margin:12px 0 0;padding:12px 16px;border:1px dashed var(--field);border-radius:6px;font-size:14px}
.wait b{color:var(--field)}
.wait ul{margin:6px 0 0;padding-left:18px}

/* легенда и фильтр */
.legend{display:flex;flex-wrap:wrap;gap:6px 16px;align-items:center;font-size:13px;color:var(--muted)}
.legend .k{display:inline-flex;align-items:center;gap:6px}
.dot{width:10px;height:10px;border-radius:2px;display:inline-block;flex:none}
.bar{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0 6px}
.bar button{font:inherit;font-size:13.5px;font-weight:600;background:var(--sheet);color:var(--ink);border:1px solid var(--line);border-radius:4px;padding:6px 14px;cursor:pointer}
.bar button[aria-pressed="true"]{background:var(--ink);border-color:var(--ink);color:var(--paper)}

/* дерево */
.tree{position:relative}
.tree::before{content:"";position:absolute;left:33px;top:8px;bottom:8px;width:2px;background:linear-gradient(var(--green),var(--blue))}
.h{display:grid;grid-template-columns:68px minmax(0,1fr);gap:16px;padding:11px 0;position:relative}
.code{position:relative;z-index:1;align-self:start;width:68px;text-align:center;font-family:var(--mono);font-weight:700;font-size:15px;padding:7px 0;border-radius:4px;background:var(--sheet);border:1.5px solid var(--line)}
.h.node .code{background:var(--ink);border-color:var(--ink);color:var(--paper)}
.h.cand .code{border-style:dashed;border-color:var(--field)}
.h.node.cand .code{background:var(--field);border-color:var(--field);border-style:solid;color:var(--sheet)}
.title{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 10px}
.title strong{font-size:17px;font-weight:700}
.chip{font-size:12px;font-weight:600;border-radius:3px;padding:1px 8px;border:1px solid var(--line);color:var(--muted)}
.chip.s-ok{color:var(--plus);border-color:var(--plus)}
.chip.s-shift{color:var(--shift);border-color:var(--shift)}
.chip.s-q{color:var(--minus);border-color:var(--minus)}
.chip.s-cand{color:var(--field);border-color:var(--field)}
.chip.nodechip{background:var(--green-soft);border-color:transparent;color:var(--plus)}
.chip.newchip{background:var(--blue-soft);border-color:transparent;color:var(--new)}
.say{margin:3px 0 0;max-width:80ch}
.now{margin:6px 0 0;font-size:14px;color:var(--muted);max-width:88ch}
.now b{color:var(--ink);font-weight:600}
.cards{list-style:none;margin:10px 0 2px;padding:0;border-left:2px solid var(--line)}
.cards li{display:grid;grid-template-columns:52px minmax(0,1fr);gap:10px;padding:5px 0 5px 14px;position:relative;font-size:14px}
.cards li::before{content:"";position:absolute;left:-2px;top:15px;width:10px;height:2px;background:var(--line)}
.cards li.new::before{background:var(--new)}
.cards li.new time{color:var(--new);font-weight:700}
.cards .nm{font-weight:600}
.tag{font-weight:700}
.t-plus{color:var(--plus)} .t-shift{color:var(--shift)} .t-minus{color:var(--minus)} .t-form{color:var(--form)} .t-field{color:var(--field)} .t-mat{color:var(--mat)}

/* указатель */
.idx{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:0 24px}
.idx div{display:flex;gap:8px;align-items:baseline;border-bottom:1px solid var(--line);padding:6px 0;font-size:14px;min-width:0}
.idx time{flex:none;width:44px}
.idx .n{flex:1;min-width:0}
.idx .to{font-family:var(--mono);font-size:11.5px;color:var(--shift);text-align:right;flex:none;max-width:45%}
.out{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:0 24px}
.out div{border-top:2px solid var(--ink);padding:10px 0 14px;min-width:0}
.out h3{margin:0 0 4px;font-size:14px;font-weight:700}
.out p{margin:0;font-size:14px}
.foot{margin-top:36px;padding-top:14px;border-top:1px solid var(--line);color:var(--muted);font-size:13px}
.foot ul{margin:6px 0 0;padding-left:18px;max-width:90ch}

@media (max-width:860px){
  .band{grid-template-columns:1fr}
  .core{grid-template-columns:1fr}
  .core>div{border-left:0;border-top:1px solid var(--line)}
  .core>div:first-child{border-top:0}
  .moves li{grid-template-columns:52px minmax(0,1fr)}
  .moves .to{grid-column:2;white-space:normal}
}
@media (max-width:520px){
  .counts{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:10px}
  .h{grid-template-columns:54px minmax(0,1fr);gap:10px}
  .code{width:54px;font-size:13px}
  .tree::before{left:26px}
  .cards li{grid-template-columns:1fr;gap:0}
  .idx{grid-template-columns:1fr}
}
</style>
