---
import Base from '../layouts/Base.astro';
const items = [
  { n: 'I', t: 'Анаксимандр', f: '/exercises/Упражнение I — Анаксимандр.pdf', d: 'Первое занятие: фрагмент об апейроне, упражнение на гибкость мышления.' },
  { n: 'II', t: 'Пифагор и Гераклит', f: '/exercises/Упражнение II — Пифагор и Гераклит.pdf', d: 'Число и логос: два способа держать противоположности вместе.' },
  { n: 'III', t: 'Парменид. О природе', f: '/exercises/Упражнение III — Парменид. О природе.pdf', d: 'Поэма Парменида в переводах Лебедева и Гаспарова; путь Истины и путь Мнения.' },
];
---
<Base
  title="Упражнения курса: Анаксимандр, Пифагор, Гераклит, Парменид — раздатки PDF"
  description="Раздатки-упражнения курса «Метод Платона»: медленное чтение фрагментов первых греческих философов с заданиями на гибкость мышления. Свободно скачиваемые PDF."
  path="/exercises"
>
  <span class="kick">Интеллектуальный гимнастический зал</span>
  <h1>Упражнения</h1>
  <p class="sub">Медленное чтение первых греческих философов — по одному фрагменту и одному упражнению на занятие.</p>
  <p>Каждая раздатка — самостоятельный снаряд: текст фрагмента в переводе и греческий оригинал под рукой, вопросы для медленного чтения и упражнение на гибкость мышления. Их можно проходить в одиночку, но задуманы они для разговора в группе из 4–8 человек.</p>
  {items.map((i) => (
    <article class="card">
      <span class="bookmark">упражнение {i.n}</span>
      <h3><a href={i.f} target="_blank">{i.t}</a></h3>
      <p class="ann">{i.d}</p>
      <span class="meta">PDF · A5 · открыть</span>
    </article>
  ))}
  <h2>Фигуры зала</h2>
  <p>Каждое упражнение раздаток — одна из фигур античного зала: перевод с листа как бег, гипотеза как прыжок с гальтерами, определение как диск. Две страницы с атлетами на вазах из Метрополитен-музея и разбором, что именно тренирует каждый ход.</p>
  <p class="actions">
    <a class="btn ghost" href="/figures/1">I. Пентатлон</a>
    <a class="btn ghost" href="/figures/2">II. Палестра</a>
  </p>
  <p class="mut">Раздатки добавляются по ходу потока. Одностраничник курса: <a href="/META_Brain_onepager.pdf" target="_blank">META Brain onepager (PDF)</a>.</p>
</Base>

