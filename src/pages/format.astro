---
import Base from '../layouts/Base.astro';
import { TELEGRAM } from '../i18n';

// Одна встреча по минутам — первое занятие потока, 24 августа 2026 (по записи).
const timeline = [
  ['0–5', 'Собираемся. Видео по возможности у всех — чтобы была обратная связь.'],
  ['5–14', 'Рамка на входе: что за текст, почему «полигон», а не метод; логика и диалектика; чего ждать и чего не ждать.'],
  ['14–20', 'Круг ожиданий: по минуте на человека. Кто откуда и зачем пришёл.'],
  ['20–30', 'Упражнение: одна фраза Анаксимандра — греческий оригинал и три английских перевода на экране. Пять минут на свой русский перевод, результат — в общий чат. Русские переводы до этого не смотрим.'],
  ['30–45', 'Читаем греческий вслух, слово за словом: γένεσις, τὸ χρεών, χρόνος, ἀλλήλοις. Каждого просят сказать, как он понимает «то, откуда».'],
  ['45–75', 'Разбор: апейрон против воды Фалеса; почему вещи «платят друг другу пеню»; как юридический словарь полиса переносится на природу. Все версии — в том числе «я не понимаю, о чём он» — идут в дело.'],
  ['75–90', 'Мост к Гераклиту: «война — отец всего», гармония лука и лиры. Одно современное эхо — по выбору участника.'],
  ['90–105', 'Круг впечатлений: два слова от каждого. Домашнее задание и план на среду.'],
];

const principles = [
  ['Один текст, медленно', 'На встречу — один фрагмент оригинала. Греческий всегда на экране, даже если никто в группе его не читает: слова, из которых выросли наши понятия, надо видеть.'],
  ['Сначала своё, потом чужое', 'Перевод, интерпретацию, пример участник делает сам — до того, как увидит, что написано у Лебедева или Хайдеггера. Так у каждого появляется, с чем сравнивать.'],
  ['Противоречие — хороший знак', 'В логике противоречие сигнал ошибки. В диалектике — признак того, что думать начали. Если до противоречия не дошли, мы ещё не думали.'],
  ['«Не понимаю» — это ход', 'Точно сформулированное непонимание («не вижу ни одного примера, когда так бывает») ценится выше гладкого пересказа. Из него растёт обсуждение.'],
  ['Дружеское расследование', 'Диалектика у Платона — не полемика софистов, а совместное размышление друзей. Но не поддакивание: мы идём до границ в обе стороны, в мою и в твою, и не защищаем свою позицию только потому, что она своя.'],
  ['Не нашими категориями', 'У этих людей ещё не было слов «бытие», «сущность», «логика» в нашем смысле. Мы пытаемся думать до категорий, которые они как раз изобретают.'],
  ['Каждый уносит своё', 'Цель не в том, чтобы ведущий передал своё прочтение. Цель — чтобы каждый проделал несколько содержательных ходов вслух, вместе с другими, и вышел за периметр, который возникает при чтении в одиночку.'],
  ['Полигон, а не лекция', 'Ведущий задаёт рамку и вызывает поимённо; говорят участники. Тихих спрашивают первыми. Запись есть, пропуск не критичен, но к тексту возвращаемся вместе.'],
];

// Пять переводов одной фразы — как есть, из общего чата, без имён.
const translations = [
  'Откуда даётся вещам рождение, туда же они и воротятся в назначенный срок, в соответствии с роковой задолженностью, выплачивая друг другу меру за принесённый ущерб.',
  'То место, откуда исходит вещь, чем бы она ни была, — также место исчезновения, из-за нужды компенсировать их за несправедливость вместе с проходом времени.',
  'Где вещи имеют начала, там они и должны уходить в срок, ибо должны быть судимы за несправедливость по номосу времени.',
  'Откуда вещи берут своё начало, там же они должны исчезнуть. Они должны наказываться и судиться за их несправедливость в соответствии с законами времени.',
  'Откуда вещи имеют своё происхождение, туда они должны неизбежно возвратиться; они должны выплатить задолженность в соответствии с требованиями времени.',
];

const voices = [
  ['Сложно — но это пробудило интерес. Готов постепенно работать, чтобы разобраться лучше. Мне понравилось.', 'школьник, 15 лет, физмат'],
  ['Есть интрига: вы начали с того, что это основополагающий текст, и хочется прочитать его вместе. А ближе ко второй половине удалось войти в состояние потока. Если философия даёт его, это уже само по себе классно.', 'выпускник физмата МГУ'],
  ['Не скажу, что понял, что мы делаем: понятно, что это закидывание удочки, но не совсем ясно, куда она летит. Но мне интересно погрузиться в греческую философию хоть таким своеобразным методом.', 'социолог'],
  ['Было немного тяжело. Но это подводящие к диалогу вещи, которые нужно понимать, чтобы потом не утонуть. Пока осилить можно. Нить точно есть.', 'социолог'],
  ['Это не выглядит как стандартный семинар — скорее интеллектуальное упражнение. Ответов на поставленные вопросы для себя пока не вижу. Но серое вещество греется гораздо сильнее, чем обычно, и я ловлю некоторую эстетику.', 'социолог'],
  ['Это пройденный на первом курсе материал, но к нему важно возвращаться: сейчас связи внутри него стали яснее, и интересно, как они соотносятся друг с другом. Буду ходить обязательно.', 'студент философского факультета'],
];
---
<Base
  title="Формат: как устроена встреча частного семинара медленного чтения «Парменида»"
  description="Одна встреча по минутам, восемь принципов работы, пять переводов одной фразы Анаксимандра и голоса участников первого занятия. Zoom, 75–105 минут, 4–8 человек, один фрагмент оригинала на встречу."
  path="/format"
  jsonld={{
    '@context': 'https://schema.org', '@type': 'Article',
    headline: 'Формат: как устроена встреча',
    description: 'Как проходит встреча частного семинара медленного чтения «Парменида»: хронометраж, принципы, упражнение с переводом, отзывы участников.',
    author: { '@type': 'Person', name: 'Тимур Атнашев' },
    publisher: { '@type': 'EducationalOrganization', name: 'Parmenides Academy', url: 'https://parmenides.academy' },
    inLanguage: 'ru',
  }}
>
  <section class="cover">
    <span class="rule"></span>
    <span class="kick">Формат</span>
    <h1>Как устроена встреча</h1>
    <p class="sub">Не лекция и не стандартный семинар. Один фрагмент оригинала, пять минут на своё, потом — вместе</p>
    <span class="greek">ἀλλήλοις</span>
    <span class="orn">❈</span>
    <p class="formula">Zoom · 4–8 человек · 75 минут (первая встреча ушла на 105) · два-три раза в неделю · разные поколения в одной группе: от пятнадцати до пятидесяти</p>
    <p class="actions">
      <a class="btn" href={TELEGRAM} target="_blank" rel="noopener">Записаться</a>
      <a class="btn ghost" href="/exercises">Раздатки</a>
    </p>
  </section>

  <section>
    <h2>Что происходит на встрече</h2>
    <p>Перед встречей участники получают раздатку: фрагмент оригинала с подстрочником, два-три классических перевода и несколько вопросов. На встрече текст на экране, ведущий задаёт рамку и вызывает поимённо; говорят участники. Каждое занятие держится на одном упражнении — перевести фразу, примерить чужое понимание, найти пример из своей жизни, довести чужой аргумент до предела. В конце — круг: два слова от каждого о том, как работалось.</p>
    <p>Первая ступень — девять встреч: первые греческие философы (Анаксимандр, Пифагор, Гераклит, поэма Парменида) как ингредиенты, а затем диалог Платона «Парменид», в котором эти ингредиенты собраны в одну конструкцию. Дальше — <a href="/ladder">продвинутые ступени</a>.</p>
  </section>

  <section>
    <h2>Одна встреча по минутам</h2>
    <p class="mut">Первое занятие потока, 24 августа 2026, по записи.</p>
    <ol class="tl">
      {timeline.map(([t, d]) => (
        <li><span class="t">{t}</span><span class="d">{d}</span></li>
      ))}
    </ol>
  </section>

  <section class="shots">
    <h2>Кадры</h2>
    <div class="grid">
      <figure><img src="/img/zoom_z1.png" alt="Восемь окон Zoom: участники первой встречи" loading="lazy" /><figcaption>Первая встреча, 24 августа 2026: от пятнадцати до пятидесяти в одной группе</figcaption></figure>
      <figure><img src="/img/handout_parmenides.png" alt="Раздатка: поэма Парменида, фрагмент B2 с подстрочником и переводы Лебедева и Гаспарова" loading="lazy" /><figcaption>Раздатка к третьей встрече: греческий с подстрочником, рядом Лебедев и Гаспаров — так текст выглядит на экране</figcaption></figure>
    </div>
  </section>

  <section id="translations">
    <h2>Пять переводов одной фразы</h2>
    <p>Изречение Анаксимандра — полторы фразы, возможно, древнейший философский текст, дошедший до нас целиком. На первой встрече у каждого было пять минут, чтобы перевести его самому, глядя на греческий и английский. Вот что получилось — как есть, из общего чата.</p>
    <p class="gr" lang="grc">ἐξ ὧν δὲ ἡ γένεσίς ἐστι τοῖς οὖσι, καὶ τὴν φθορὰν εἰς ταῦτα γίνεσθαι κατὰ τὸ χρεών· διδόναι γὰρ αὐτὰ δίκην καὶ τίσιν ἀλλήλοις τῆς ἀδικίας κατὰ τὴν τοῦ χρόνου τάξιν.</p>
    <ol class="tr">
      {translations.map((s) => <li>{s}</li>)}
    </ol>
    <p class="mut">Только в одном из пяти сохранилось ἀλλήλοις — «друг другу». Вокруг этого слова и выстроился разговор: вещи платят пеню не кому-то наверху, а друг другу, самим фактом своего присутствия.</p>
  </section>

  <section id="principles">
    <h2>Принципы</h2>
    {principles.map(([t, d], i) => (
      <div class="pr">
        <span class="pn">{['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII'][i]}</span>
        <div><h3>{t}</h3><p>{d}</p></div>
      </div>
    ))}
  </section>

  <section class="figlinks">
    <h2>Фигуры зала</h2>
    <p>Что именно тренирует каждое упражнение — показано на тех, кто тренировал настоящие мышцы: атлеты на греческих вазах, по одной фигуре на каждый ход мысли.</p>
    <p class="actions">
      <a class="btn ghost" href="/figures/1">I. Пентатлон</a>
      <a class="btn ghost" href="/figures/2">II. Палестра</a>
    </p>
  </section>

  <section id="voices">
    <h2>Как работалось</h2>
    <p class="mut">Круг впечатлений после первой встречи. Без имён.</p>
    {voices.map(([q, who]) => (
      <blockquote>{q}<span class="who">{who}</span></blockquote>
    ))}
  </section>

  <section class="terms">
    <h2>Запись</h2>
    <p>Участие — по рекомендации или после короткого собеседования. Следующий поток набирается, когда собирается группа из 4–8 человек. 240 евро в месяц; бесплатно для участников до 30 лет, учащихся и временно не работающих.</p>
    <p class="actions"><a class="btn" href={TELEGRAM} target="_blank" rel="noopener">Написать Тимуру</a> <span class="mut">Напишите о себе в двух словах — договоримся о собеседовании</span></p>
  </section>
</Base>

<style>
  .tl { list-style: none; padding: 0; margin: 0; max-width: none; }
  .tl li { display: grid; grid-template-columns: 76px 1fr; gap: 0 16px; padding: .55em 0; border-top: 1px solid var(--line); }
  .tl li:last-child { border-bottom: 1px solid var(--line); }
  .tl .t { font-variant: small-caps; letter-spacing: .12em; color: var(--gold); font-size: .9rem; padding-top: .15em; white-space: nowrap; }
  .tl .d { font-size: 1rem; }
  .shots .grid { display: grid; grid-template-columns: 1fr 1fr; align-items: start; gap: 22px; max-width: none; }
  .shots figure { margin: 0; }
  .shots .ph { aspect-ratio: 16 / 9; border: 1px solid var(--gold); outline: 1px solid var(--gold-2); outline-offset: 4px; background: var(--paper-2); display: grid; place-items: center; font-variant: small-caps; letter-spacing: .2em; color: var(--gold); font-size: .85rem; }
  .shots img { display: block; width: 100%; height: auto; border: 1px solid var(--gold); outline: 1px solid var(--gold-2); outline-offset: 4px; }
  .shots figcaption { font-size: .9rem; color: var(--ink-2, var(--ink)); margin-top: 12px; font-style: italic; }
  .gr { font-size: 1.15rem; line-height: 1.6; padding: 14px 22px; border-left: 2px solid var(--gold); background: var(--paper-2); }
  .tr { padding-left: 1.5em; }
  .tr li { margin: 0 0 .7em; font-size: 1rem; }
  .pr { display: grid; grid-template-columns: 44px 1fr; gap: 0 14px; margin: 1.2em 0; }
  .pr .pn { font-variant: small-caps; letter-spacing: .2em; color: var(--gold); font-size: .95rem; padding-top: 1.7em; text-align: right; }
  .pr h3 { margin-top: 1.4em; }
  .pr p { margin: 0; }
  .terms { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 6px 0 22px; margin-top: 2.5em; }
  .terms h2 { margin-top: 1em; }
  @media (max-width: 640px) {
    .shots .grid { grid-template-columns: 1fr; }
    .tl li { grid-template-columns: 62px 1fr; }
    .pr { grid-template-columns: 30px 1fr; }
  }
</style>
