---
import Base from '../layouts/Base.astro';
import { TELEGRAM } from '../i18n';
import { contours } from '../data/figureContours';

const voices = [
  ['Кирилл Кринкин', 'исследователь ИИ, JetBrains', 'Древний философский метод превратился в алгоритмизируемый инструмент анализа. Особенно ценно практическое применение — протаскивание собственных рабочих понятий через «решётку Парменида». Это как метод главных компонент, только для смыслового пространства.'],
  ['Мария Назарова', 'предприниматель', 'Очень понравилась идея объединить греческий язык, античность и философию — такой подход делает всё намного живее и понятнее. Отдельно ценно, что философия здесь остаётся сложной, без упрощений — это редкость.'],
  ['Кирилл Богачев', 'нефтяник, коуч', 'В университете думал: зачем мне, нефтянику, философия. И спустя двадцать лет добровольно пошёл на курс к Тимуру Атнашеву. Мозг работал, как мышцы в спортзале: ещё два подхода параграфа Парменида, отдых и ещё один.'],
  ['Эвелина Садыкова', 'предприниматель', 'Неожиданно ощутила, что могу с интересом выслушивать чужие точки зрения. Стало легче формулировать свои мысли и яснее их высказывать. А ещё пропало желание обращать всех собеседников в свою веру — и это освобождает столько энергии.'],
];
---
<Base
  title="Parmenides Academy — частный семинар медленного чтения: «Парменид» Платона как полигон мышления"
  jsonld={{
    '@context': 'https://schema.org', '@type': 'Course',
    name: 'Метод Платона: «Парменид» как полигон мышления (частный семинар)',
    description: 'Восемь встреч медленного чтения первых греческих философов и «Парменида» Платона в группе 4–8 человек.',
    provider: { '@type': 'EducationalOrganization', name: 'Parmenides Academy', url: 'https://parmenides.academy' },
    instructor: { '@type': 'Person', name: 'Тимур Атнашев', jobTitle: 'PhD, философ, специалист по интеллектуальной истории' },
    inLanguage: 'ru',
    hasCourseInstance: { '@type': 'CourseInstance', courseMode: 'online', startDate: '2026-10-27', courseWorkload: 'PT10H', offers: { '@type': 'Offer', price: '300', priceCurrency: 'EUR', category: 'в месяц; бесплатно для участников до 30 лет' } },
  }}
  description="Частный семинар медленного чтения классических текстов для взрослых и подростков; участие — по рекомендации или после собеседования. Восемь встреч в малой группе: первые греческие философы и «Парменид» Платона — самый трудный текст западной традиции. Ведёт философ Тимур Атнашев, PhD."
  path="/"
>
  <section class="cover">
    <span class="rule"></span>
    <span class="kick">Интеллектуальный гимнастический зал</span>
    <h1>«Парменид» Платона<br />как полигон мышления</h1>
    <p class="sub">Частный семинар медленного чтения — для тех, кто готов работать и способен понимать</p>
    <span class="greek">Πλάτων · Παρμενίδης · 137c–166c</span>
    <span class="genre">участие — по рекомендации или после собеседования</span>
    <span class="orn">❈</span>
    <span class="author">Тимур Атнашев</span>
    <p class="actions">
      <a class="btn" href={TELEGRAM} target="_blank" rel="noopener">Написать Тимуру</a>
      <a class="btn ghost" href="/map">Карта филиаций</a>
    </p>
  </section>

  <section class="treesec">
    <a href="/map" class="treelink"><img src="/img/tree_paper.svg" alt="Дерево филиаций «Парменида»: авторы в 11 ветвях вокруг диалога Платона, от IV века до н. э. до XX века" loading="eager" width="2100" height="2100" /></a>
    <p class="treecap"><span class="cap">дерево филиаций</span> — одиннадцать ветвей; радиус — время: от Академии в центре до сегодняшнего дня на ободе. <a href="/map">Открыть карту</a></p>
  </section>

  <section>
    <p>Частный семинар для взрослых и подростков: первые греческие философы и «Парменид» — медленно, вслух, сверяясь с греческим оригиналом. Восемь встреч, группа 4–8. Участие — по рекомендации или после короткого собеседования: нам важно, чтобы группа была собрана из тех, кто готов работать.</p>
    <p>Западная традиция мысли расходится от одного диалога Платона. За две с половиной тысячи лет через «Парменид» прошли неоплатоники и отцы Церкви, Николай Кузанский и каббалисты, Гегель, Хайдеггер, Бадью. Мы читаем этот текст медленно, вслух, сверяясь с греческим оригиналом, — и восходим к нему через первых греческих философов: Анаксимандра, Пифагора, Гераклита, Парменида.</p>
  </section>

  <section class="palaestra">
    <a href="/figures/1" class="pimg"><img src="/img/figures/run.jpg" alt="Бегуны на панафинейской призовой амфоре, ок. 530 до н. э." loading="lazy" width="380" height="380" /></a>
    <p class="pcap"><span class="cap">бег</span> — первая фигура зала: фраза оригинала, пять минут, собственный перевод. Панафинейская амфора, ок. 530 до н. э. <a href="/format">Как устроена встреча</a></p>
    <p class="picons">
      {['run','jump','discus','wrestle','trainer'].map((k) => (
        <a href="/figures/1" aria-label="Фигуры зала">
          <svg viewBox={`-3 -3 ${contours[k].w + 6} ${contours[k].h + 6}`} fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round" aria-hidden="true">{contours[k].d.map((d) => <path d={d} />)}</svg>
        </a>
      ))}
    </p>
    <p class="pcap2">Каждое упражнение семинара — фигура античного зала: перевод с листа как бег, гипотеза как прыжок с гальтерами, определение как диск. <a href="/figures/1">Фигуры зала</a></p>
  </section>

  <section>
    <h2>Как устроена работа</h2>
    <p>Восемь встреч по 75 минут в Zoom, группа 4–8 человек. Минимум лекций: на каждой встрече — фрагмент текста, ключевые слова оригинала, вопросы для медленного чтения и упражнение на гибкость мышления. Обсуждение строится как диалектическая беседа: не «кто прав», а «что именно здесь сказано и что из этого следует».</p>
    <p>Специальная подготовка не нужна. Нужны внимание и готовность начать думать заново — с самого начала метафизики. Опыт показывает: удивление, ступор и инсайт приходят в таком порядке и примерно на второй встрече.</p>
    <p>Раздатки к занятиям открыты — их можно посмотреть в разделе <a href="/exercises">«Упражнения»</a>.</p>
  </section>

  <section>
    <h2>Что открывает «Парменид»</h2>
    <p>Вторая часть диалога — восемь (или девять) гипотез о едином — остаётся самым трудным местом западной философии, и спор о том, что это — метафизика или логическое упражнение, — не закрыт до сих пор. Прочитавший её получает ключи к теории идей Платона, к апофатическому богословию, к спору реалистов и номиналистов, к Каббале и науке Нового времени, к Гегелю, Щедровицкому и Деррида.</p>
    <p>Главный результат — не сумма сведений, а способность самостоятельно мыслить диалектически в контексте традиции длиной в 2500 лет. Как эта традиция ветвится от одного текста, показывает <a href="/map">карта филиаций</a>: сорок пять авторов, у каждого — канал передачи, учение и источники.</p>
  </section>

  <section>
    <h2>Ведущий</h2>
    <p><strong>Тимур Атнашев, PhD</strong> — философ, переводчик, специалист по интеллектуальной истории. Экс-профессор Шанинки и РАНХиГС; fellow TU Dresden, Université de Toulouse, Université libre de Bruxelles. Автор и редактор книг по интеллектуальной истории, соредактор одноимённой <a href="https://www.nlobooks.ru/books/intellektualnaya_istoriya/" target="_blank" rel="noopener">серии издательства «Новое литературное обозрение»</a>, соведущий подкаста <a href="https://nlobooks.ru/nlomedia/catalog/umnye-knigi/" target="_blank" rel="noopener">«Умные книги»</a>. Сооснователь компании <a href="https://www.metagames.academy/" target="_blank" rel="noopener">MetaGames Lab</a>.</p>
    <p>С 2023 года постоянно ведёт дружеский диалектический семинар по диалогу Платона «Парменид».</p>
    <blockquote>Каждый уважающий себя взрослый имеет право понимать философию.<span class="who">Тимур Атнашев</span></blockquote>
  </section>

  <section class="terms">
    <h2>Ближайший поток</h2>
    <p><strong>Старт 27 октября.</strong> Встречи по четвергам в 19:00 по Кипру (Zoom). Длительность — два месяца, восемь–девять встреч. На первой встрече читаем фрагмент Анаксимандра, делаем упражнение и знакомимся.</p>
    <p>Участие — 300 евро в месяц. Бесплатно для участников до 30 лет, учащихся и временно не работающих. При финансовых ограничениях — напишите, договоримся.</p>
    <p class="actions"><a class="btn" href={TELEGRAM} target="_blank" rel="noopener">Написать Тимуру</a> <span class="mut">Напишите о себе в двух словах — договоримся о собеседовании</span></p>
  </section>

  <section>
    <span class="orn">❈</span>
    <h2>Голоса участников</h2>
    <div class="voices">
      {voices.map(([n, r, q]) => (
        <figure>
          <blockquote>{q}</blockquote>
          <figcaption><span class="who">{n}</span><span class="mut">{r}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section>
    <h2>Библиотека</h2>
    <p>Прежде всего — <a href="/parmenid">сам диалог целиком</a>: греческий оригинал Бёрнета и русский перевод рядом, 201 раздел по Стефанусу, у каждого постоянная ссылка вида <span class="mono">parmenides.academy/parmenid/137c</span>. В русской сети такого не было.</p>
    <p>Дальше — материалы, которых нет в открытом доступе в таком виде: <a href="/map">карта филиаций «Парменида»</a> с источниками по каждому из пятидесяти шести узлов; <a href="/polygons">три полигона вне Запада</a> — «Чжуан-цзы», Нагарджуну и Ибн Араби в авторских переводах спорных мест; <a href="/exercises">раздатки-упражнения</a> по первым греческим философам. Всё это открыто и пополняется. Полный список — в разделе <a href="/materials">«Материалы»</a>.</p>
  </section>
</Base>

<style>
  .mono { font-family: var(--serif); background: var(--paper-2); padding: 1px 5px; border-radius: 2px; font-size: .92em; }
  .palaestra { margin: 2.4em 0 2.2em; text-align: center; }
  .palaestra .pimg { display: block; text-decoration: none; }
  .palaestra img { width: 100%; max-width: 380px; height: auto; display: block; margin: 0 auto; border: 1px solid var(--gold); outline: 1px solid var(--gold-2); outline-offset: 4px; }
  .palaestra .pcap { font-style: italic; color: var(--soft); max-width: 52ch; margin: 16px auto 0; font-size: .95rem; }
  .palaestra .pcap .cap { font-style: normal; }
  .palaestra .picons { display: flex; justify-content: center; align-items: flex-end; gap: 26px; margin: 22px auto 6px; color: var(--gold); max-width: none; }
  .palaestra .picons a { line-height: 0; opacity: .8; text-decoration: none; }
  .palaestra .picons a:hover { opacity: 1; color: var(--green); }
  .palaestra .picons svg { height: 44px; width: auto; display: block; }
  .palaestra .pcap2 { font-size: .95rem; color: var(--soft); max-width: 62ch; margin: 4px auto 0; }
  .treesec { margin: -10px 0 40px; text-align: center; }
  .treesec img { width: 100%; max-width: 860px; height: auto; display: block; margin: 0 auto; }
  .treelink { text-decoration: none; display: block; }
  .treecap { font-style: italic; color: var(--soft); max-width: 60ch; margin: 14px auto 0; font-size: 1rem; }
  .treecap .cap { font-style: normal; }
  .voices { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 10px 36px; }
  .voices figure { margin: 0 0 1.2em; }
  .voices blockquote { font-size: 1rem; margin: 0 0 .5em; border-left-color: var(--gold-2); }
  .voices figcaption { font-size: .9rem; }
  .voices figcaption .who { display: inline; margin-right: 8px; }
  .voices figcaption .mut { font-style: italic; }
  .terms { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 6px 0 22px; margin-top: 2.5em; }
  .terms h2 { margin-top: 1em; }
</style>
