---
import Base from '../layouts/Base.astro';
import { TELEGRAM } from '../i18n';

// Продвинутые ступени — эскиз. Состав меняется по ходу работы.
const stages = [
  {
    n: 'II', t: 'Карта', sub: 'Академия — Аристотель — стоики — Декарт — Кант — Оккам — Витгенштейн', len: 'одиннадцать встреч',
    q: 'Как мысль научилась раскладывать мир по полочкам — и обнаружила, что полочки стоят в ней самой.',
    moves: [
      ['Древняя Академия', 'спор вокруг «Парменида» у Спевсиппа и Ксенократа — полемический контекст, из которого вышел Аристотель. Мост от первой ступени ко второй.'],
      ['Аристотель, «Категории»', 'десять полочек за одну страницу: прогоняем чашку, книгу, самого себя по всем десяти. Первая сущность — вот этот человек, вот эта лошадь.'],
      ['Аристотель, «Метафизика» Ζ', 'медный шар распадается на форму, материю и составное; сущность — суть бытия (τὸ τί ἦν εἶναι), и у вещи с материей она с вещью не совпадает. Уникальность — от материи, а материя непознаваема. Развилка, из которой вырастут обе следующие ступени.'],
      ['Стоики', 'от мышления о вещах к мышлению о связях: «если… то…». Второй инструмент — логика.'],
      ['Декарт, «Размышления» I–II', 'радикальное сомнение и точка опоры. Карта исчезает, остаётся картограф.'],
      ['Декарт, «Размышление» III', 'как из «я» заново построить мир: Бог как гарант. Первая попытка выйти наружу.'],
      ['Кант, предисловие ко второму изданию', 'коперниканский переворот: не знание сообразуется с предметами, а предметы — со способом познания.'],
      ['Кант, феномен и ноумен', 'границы карты. Единство вещи не дано, а производится синтезом — здесь кончается «просто вещь».'],
      ['Оккам, «Сумма логики» I', 'бритва после Канта: реально только единичное, общее — имя. Не инструмент, а выбор одной половины Аристотеля.'],
      ['Витгенштейн, «Трактат»', 'язык как карта, у которой та же логическая структура, что и у мира.'],
      ['Витгенштейн, тезис 7', '«о чём невозможно говорить…». Первая тишина курса; дверь на третью ступень.'],
    ],
  },
  {
    n: 'III', t: 'Лестница', sub: 'Плотин — Прокл — Дионисий — Экхарт — Зоар — Спиноза — первая гипотеза', len: 'десять встреч',
    q: 'Что находится по ту сторону бытия — и можно ли туда подняться, а не только указать.',
    moves: [
      ['Плотин, «Эннеады»: Единое', 'источник, который не есть ничто из того, что порождает. Мыслим не сущее, а его сверхбытийную причину. По-гречески единое, единица и единство — одно слово, τὸ ἕν, и единое для греков не число: число предполагает множество.'],
      ['Плотин: эманация', 'Ум и Душа как переливание через край — не творение из ничего, а разворачивание из полноты.'],
      ['Плотин: восхождение', 'путь души домой; лестница — не теория, а практика.'],
      ['Прокл и «Книга о причинах»', 'комментарий Прокла к «Пармениду» — самый прочный канал: Liber de Causis, компендий из Прокла, Фома читал как трактат Аристотеля. Так гипотезы вошли в схоластику.'],
      ['Псевдо-Дионисий, «О мистическом богословии»', 'апофатика как строгий метод: последовательно отрицать всё, что можно сказать.'],
      ['Майстер Экхарт', 'Божество за пределами Бога; отрицание доведено до опустошения ума.'],
      ['«Зоар», сфирот', 'второй язык для невыразимого — не молчание, а символ. Эйн-Соф и сфирот как первая и вторая гипотезы.'],
      ['Спиноза, «Этика» I', 'лестница, ведущая вниз: Единое не наверху, а здесь. Deus sive Natura.'],
      ['Дуэль: Плотин против Спинозы', 'бежать из мира к Единому — или мир и есть Единое. Выбор между двумя монизмами.'],
      ['Первая гипотеза, 137c–142a', 'возвращение к тексту: «если единое едино — его нет». Что мы слышим в этом теперь.'],
    ],
  },
  {
    n: 'IV', t: 'Личность', sub: 'Лакан — каппадокийцы — Боэций — Скот и Оккам — Декарт — Юм — Сартр — Левинас', len: 'девять встреч',
    q: 'Есть ли «я» — вещь, пучок или отношение; и откуда вообще взялась мысль о незаменимом.',
    moves: [
      ['Лакан, о личности в метафизической традиции', 'две ловушки: субстанция («душа») и пустота («пучок восприятий»). Карта местности на весь курс.'],
      ['Троица', 'как античная логика сущностей сломалась о вопрос, которого не задавали греки.'],
      ['Каппадокийцы: ипостась', 'поворот от «что» к «кто». Личность как отношение, а не вещь.'],
      ['Боэций, Августин', '«индивидуальная субстанция разумной природы»: отношение схлопывается в вещь и уходит внутрь.'],
      ['Скот и Оккам: этость', 'бытие уникальной вот-вещи — интуиция, которой нет у Платона: незаменимое как предмет мысли.'],
      ['Декарт', 'cogito как апофеоз субстанции — и как одиночество.'],
      ['Юм', 'пучок восприятий. Седьмая гипотеза «Парменида», приложенная к «я»: кажется одним, распадается вблизи.'],
      ['Сартр', 'существование предшествует сущности: если «я» не вещь и не ничто, то оно — действие.'],
      ['Левинас (или Бубер)', 'лицо Другого: «я» рождается не из себя. Круг замыкается на каппадокийцах — на светском языке.'],
    ],
  },
];

const hinges = [
  ['Развилка Аристотеля', 'в «Категориях» первая сущность — вот этот человек; в седьмой книге «Метафизики» сущность — суть бытия, которая у вещей с материей с самой вещью не совпадает: уникальное остаётся на стороне материи, то есть непознаваемого. Аристотель сам называет это развилкой и не закрывает её. Вторая ступень идёт по стороне вот-вещи, третья — по стороне формы; это две стороны «Парменида», записанные одним человеком без гипотез.'],
  ['Кант как перенос', 'до Канта единство вещи дано — творением или самой вещью; после — производится синтезом. Здесь вторая ступень передаёт четвёртой самый трудный вопрос: что держит «я» одним.'],
  ['Две тишины', 'вторая ступень кончается молчанием Витгенштейна, третья — первой гипотезой. Одна тишина логическая, другая апофатическая; курс устроен так, чтобы их различить.'],
  ['Незаменимое', 'единое «Парменида» — Единое, а не вот-это. Средневековье впервые делает уникальное предметом бытия: Скот даёт ему имя — этость, Оккам идёт дальше и оставляет только единичную вещь, одну саму собой, без общего и без добавок. Четвёртая ступень — о том, куда эта интуиция ушла, когда наука сделала вещь экземпляром.'],
  ['Седьмая гипотеза', '«каждая кажется одной, но не есть одна; вблизи и острым умом — бесконечна» (164b–165e). Судьба всякой «просто вещи», когда за ней перестаёт стоять гарант, — и судьба «я» у Юма.'],
];

const scatter = [
  'Аристотель', 'стоики', 'Плотин', 'каппадокийцы', 'Августин', 'Боэций', 'Псевдо-Дионисий', 'Экхарт', 'Дунс Скот', 'Оккам', '«Зоар»', 'Декарт', 'Спиноза', 'Лейбниц', 'Юм', 'Кант', 'Кьеркегор', 'Витгенштейн', 'Лакан', 'Сартр', 'Левинас', 'Делёз', 'Бадью', 'Мейясу',
];
---
<Base
  title="Продвинутые ступени: Карта, Лестница, Личность — эскиз курса после «Парменида»"
  description="Три продвинутые ступени частного семинара медленного чтения для тех, кто прошёл первую: Аристотель и Кант, Плотин и Спиноза, каппадокийцы и Левинас. Эскиз в работе: россыпь авторов, шарниры между ступенями, тропы внутри. Запись открыта."
  path="/ladder"
  jsonld={{
    '@context': 'https://schema.org', '@type': 'Course',
    name: 'Продвинутые ступени: Карта, Лестница, Личность',
    description: 'Три ступени медленного чтения после «Парменида»: Аристотель — Кант — Витгенштейн; Плотин — Спиноза; каппадокийцы — Юм — Левинас.',
    provider: { '@type': 'EducationalOrganization', name: 'Parmenides Academy', url: 'https://parmenides.academy' },
    instructor: { '@type': 'Person', name: 'Тимур Атнашев' },
    inLanguage: 'ru',
    coursePrerequisites: 'Первая ступень: первые греческие философы и «Парменид» Платона',
  }}
>
  <section class="cover">
    <span class="rule"></span>
    <span class="kick">В работе · эскиз</span>
    <h1>Продвинутые ступени</h1>
    <p class="sub">Для тех, кто прошёл первую — первых греков и «Парменида» — и хочет идти дальше</p>
    <span class="greek">Карта · Лестница · Личность</span>
    <span class="orn">❈</span>
    <p class="formula">Три ступени по десять–одиннадцать встреч. Не «пройти авторов», а совершить за одну встречу один поворот мысли — на одной странице оригинала.</p>
    <p class="actions">
      <a class="btn" href={TELEGRAM} target="_blank" rel="noopener">Записаться</a>
      <a class="btn ghost" href="/">Первая ступень</a>
    </p>
  </section>

  <section>
    <p>Путь — один, через весь диалог; троп много. Это не программа, а эскиз: россыпь имён, шарниры, на которых держится замысел, и тропы внутри каждой ступени. Состав меняется по ходу работы — в том числе от того, кто соберётся в группе. Порядок ступеней не обязателен: вторая и третья — две ветви одной развилки, и начать можно с любой.</p>
    <p>Правило прежнее: по одному фрагменту оригинала на встречу, греческий и латинский оригиналы под рукой, разговор вместо лекции. Разница с первой ступенью — в том, что «Парменид» теперь не цель, а инструмент: мы держим его в руках и смотрим, что он делает с чужими текстами.</p>
  </section>

  <section>
    <h2>Россыпь</h2>
    <p class="scatter">{scatter.map((s, i) => <span>{s}{i < scatter.length - 1 ? ' · ' : ''}</span>)}</p>
    <p class="mut">Двадцать с лишним имён на три ступени. Не все войдут; некоторые — Лейбниц, Бадью, Мейясу — пока кандидаты, ждут проверки канала к диалогу. У Делёза канал именной: его учитель Морис де Гандийяк — специалист по «Пармениду» и его средневековой рецепции.</p>
  </section>

  <section>
    <h2>Шарниры</h2>
    <p>Пять мест, где ступени цепляются друг за друга. Они важнее списка авторов: авторов можно заменить, шарниры — нет.</p>
    {hinges.map(([t, d], i) => (
      <div class="hinge">
        <span class="hn">{['I', 'II', 'III', 'IV', 'V'][i]}</span>
        <div><h3>{t}</h3><p>{d}</p></div>
      </div>
    ))}
  </section>

  <section>
    <h2>Тропы</h2>
    {stages.map((s) => (
      <article class="stage">
        <span class="num">ступень {s.n} · {s.len}</span>
        <h3 class="st">{s.t}</h3>
        <p class="sub">{s.sub}</p>
        <p class="q">{s.q}</p>
        <ol class="moves">
          {s.moves.map(([a, d]) => (
            <li><span class="a">{a}.</span> {d}</li>
          ))}
        </ol>
      </article>
    ))}
  </section>

  <section class="terms">
    <h2>Запись</h2>
    <p>Продвинутые ступени открыты для тех, кто прошёл первую — в любом из потоков с 2023 года. Группа 4–8 человек, встречи по 75 минут в Zoom. Участие — по рекомендации или после короткого собеседования. Даты и порядок ступеней определяются, когда набирается группа; напишите — договоримся о встрече.</p>
    <p>Условия те же, что на первой ступени: 240 евро в месяц; бесплатно для участников до 30 лет, учащихся и временно не работающих.</p>
    <p class="actions"><a class="btn" href={TELEGRAM} target="_blank" rel="noopener">Написать Тимуру</a> <span class="mut">Скажите, какую ступень вы прошли и какая интересна</span></p>
  </section>
</Base>

<style>
  .scatter { max-width: none; font-family: var(--display); font-size: 1.25rem; line-height: 1.7; color: var(--ink); }
  .hinge { display: grid; grid-template-columns: 44px 1fr; gap: 0 14px; margin: 1.4em 0; }
  .hinge .hn { font-variant: small-caps; letter-spacing: .2em; color: var(--gold); font-size: .95rem; padding-top: 1.7em; text-align: right; }
  .hinge h3 { margin-top: 1.4em; }
  .hinge p { margin: 0; }
  .stage { position: relative; background: var(--paper-2); border: 1px solid var(--line); padding: 6px 30px 22px; margin: 0 0 28px; }
  .stage .num { margin: 1.2em 0 .2em; }
  .stage .st { font-family: var(--display); font-weight: 400; font-size: 1.6rem; text-align: center; margin: 0 0 .2em; }
  .stage .sub { text-align: center; font-size: 1rem; }
  .stage .q { font-style: italic; margin: 0 auto 1.2em; max-width: 60ch; text-align: center; }
  .moves { padding-left: 1.4em; margin: 0; }
  .moves li { margin: 0 0 .55em; font-size: 1rem; }
  .moves .a { font-weight: 600; }
  .terms { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 6px 0 22px; margin-top: 2.5em; }
  .terms h2 { margin-top: 1em; }
  @media (max-width: 640px) {
    .stage { padding: 6px 16px 18px; }
    .hinge { grid-template-columns: 30px 1fr; }
  }
</style>
